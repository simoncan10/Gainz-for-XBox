# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# data/ is excluded: raw is large (~1.1 GB) and not ours to redistribute.
#
# EXCEPTIONS:
# - data/reference/*.csv is hand-curated research that NO script can rebuild.
#   If it is lost, the work behind it is lost. It stays in git.
# - data/processed/*.csv is the pipeline's output. It is regenerable, but
#   kept in git so results are visible without re-running the pipeline.
/data/*
!/data/reference/
/data/reference/*
!/data/reference/*.csv
!/data/processed/
/data/processed/*
!/data/processed/*.csv
# Exception to the exception: exceeds GitHub's 100 MB push limit.
/data/processed/pipeline_dataset.csv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Agent-run scratch
# ---------------------------------------------------------------------------
# DuckDB spill directories and databases created during a multi-agent run.
# The .sql that produced a result is the record; the database is not.
**/duck_tmp/
*.duckdb
*.duckdb.wal

# ---------------------------------------------------------------------------
# Archives
# ---------------------------------------------------------------------------
# Run outputs belong in reports/<run>/ as files, not as a zip. Zipping them
# hides them from grep, from diff, and from anyone reading the repo.
*.zip

# ---------------------------------------------------------------------------
# Local tooling and editor state
# ---------------------------------------------------------------------------
.claude/settings.local.json
.claude/*.lock
.vscode/
.idea/

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
